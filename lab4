SELECT S.LNAME,S.FNAME,G.VALUE,C.COURSE_TITLE,
   TO_CHAR(G.GRADING_DATE,'DAY') AS ZI
    FROM STUDENTS S JOIN GRADES G ON S.ID_STUD=G.ID_STUD
    JOIN COURSES C ON C.ID_COURSE=G.ID_COURSE
   WHERE C.COURSE_TITLE='OOP' AND G.VALUE IN (7,10) AND TRIM(TO_CHAR(G.GRADING_DATE,'DAY'))='TUESDAY'

